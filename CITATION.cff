cff-version: 1.2.0
message: "If you use this code or its results, please cite it as below."
type: software
title: "T2T-eQTL-capstone: cis-eQTLs on T2T-CHM13 and GRCh38 in MAGE lymphoblastoid cell lines"
abstract: >-
  RNA-seq of 731 MAGE lymphoblastoid cell lines and 1000 Genomes genotypes, processed from the same raw reads on
  T2T-CHM13v2.0 and GRCh38, to measure which cis-eQTLs change with the reference genome.
authors:
  - family-names: Maulana
    given-names: Yusuf
version: 0.1.0
license: MIT
repository-code: "https://github.com/yusufdjuanda/T2T-eQTL-capstone"
keywords:
  - eQTL
  - T2T-CHM13
  - reference genome
  - segmental duplications
  - lymphoblastoid cell lines
references:
  - type: article
    title: "Molecular and genetic architecture of human gene expression across diverse ancestries (MAGE)"
    authors:
      - family-names: Taylor
        given-names: Dylan J.
    journal: "Nature"
    year: 2024
  - type: software
    title: "tensorQTL"
    authors:
      - family-names: Taylor-Weiner
        given-names: Amaro
      - family-names: Aguet
        given-names: François
    version: "1.0.10"
    url: "https://github.com/broadinstitute/tensorqtl"
