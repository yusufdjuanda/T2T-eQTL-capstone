# Pixi environments are rebuilt from pixi.lock, never committed
.pixi/*
!.pixi/config.toml

# Raw data is downloaded, not committed (see metadata/ and data/raw/README.md)
data/raw/**
!data/raw/README.md
# Processed data and results are regenerated by `pixi run reproduce` (or the cluster pipeline)
data/processed/**
!data/processed/README.md
results/**
!results/README.md

# Site settings for the cluster run (paths, Slurm queue); template: config/site.config.example
config/site.config

# Saved container images (archive them with a release, not in Git)
containers/*.tar.gz
containers/*.sif

# Workflow manager and test state
.nextflow/
.nextflow.log*
work/
.nf-test/
.nf-test.log
.pytest_cache/

# Quarto and Jupyter
/.quarto/
reports/*.html
reports/*_files/
**/*.quarto_ipynb
.ipynb_checkpoints/

# Python, R and OS clutter
__pycache__/
*.pyc
Rplots.pdf
.Rhistory
.RData
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Claude Code project instructions (local only)
CLAUDE.md
