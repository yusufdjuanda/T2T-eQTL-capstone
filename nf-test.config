// nf-test settings: tests of the Nextflow processes, workflows and the whole pipeline.
//   pixi run test-nf      (nf-test test --verbose)
// Tests live next to the pipeline in workflow/nextflow/tests/; they use small committed data in tests/data/.
config {
    testsDir "workflow/nextflow"
    workDir ".nf-test"
    configFile "workflow/nextflow/tests/nextflow.config"
}
