// Nextflow settings of the pipeline (workflow/nextflow/main.nf). Analysis settings: config/params.yaml.
//
// Profiles (choose with -profile; the pixi tasks choose for you):
//   local  (default)  every task on this machine, resources capped to fit a laptop or a CI runner
//   hpc               Slurm; cluster paths and queues from config/site.config (-c config/site.config)
//   test              placeholder inputs (tests/data/stub/) for `-stub-run` of the full pipeline
//
// Software: tasks run with the tools of the pixi environment that launched Nextflow (`pixi run ...`); tasks with
// label 'bio' (STAR, salmon, samtools, bcftools, ...) or 'qtl' (tensorQTL, plink2) also use those pixi
// environments (conf/base.config). Install them first on the cluster: pixi install --locked -e bio -e qtl

manifest {
    name = 't2t-eqtl-capstone'
    description = 'cis-eQTLs on T2T-CHM13 and GRCh38 from the same MAGE reads: which change, and where'
    mainScript = 'main.nf'
    nextflowVersion = '>=26.10.0'
}

includeConfig 'conf/base.config'

// Workflow outputs (the `output` block of main.nf) are copied here
outputDir = 'results'
workflow.output.mode = 'copy'

profiles {
    local {
        includeConfig 'conf/local.config'
    }
    hpc {
        includeConfig 'conf/hpc.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
}
