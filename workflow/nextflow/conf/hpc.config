// Profile `hpc`: one Slurm job per task. Used with the site settings, which say where the data are and which
// queues to use:  nextflow run workflow/nextflow/main.nf -profile hpc -c config/site.config --mode full
// (template: config/site.config.example). Run the Nextflow head itself in tmux or a long, small Slurm job.

process {
    executor = 'slurm'
    errorStrategy = 'retry'
    maxRetries = 1
    resourceLimits = [cpus: 64, memory: 400.GB, time: 72.h]
}

executor {
    // project limits on our cluster: 128 cores, 400 GB in total; 6 STAR tasks x 16 CPUs x 48 GB fit
    queueSize = 6
    submitRateLimit = '10/1min'
    pollInterval = '1 min'
}
