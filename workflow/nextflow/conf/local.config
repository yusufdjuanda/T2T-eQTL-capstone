// Profile `local`: every task on this machine. Requests are capped so the pipeline fits a laptop or a CI runner
// (the reproduce mode needs one CPU and a few GB per task; the full mode is not meant to run locally).

process {
    executor = 'local'
    resourceLimits = [cpus: 4, memory: 12.GB, time: 6.h]
    errorStrategy = 'terminate'
}
