// Profile `test`: the full pipeline on placeholder inputs, for `-stub-run` (every process has a stub that writes
// empty files with the right names). Checks the wiring of all steps, from the SRA download through alignment and
// eQTL mapping to the export and the analysis, in seconds and without any of the tools.
//   pixi run stub-full     (nextflow run workflow/nextflow/main.nf -profile local,test -stub-run)

params {
    mode = 'full'
    raw_dir = "${projectDir}/../../tests/data/stub/raw"
    processed_dir = 'work/stub/processed'
    samples = "${projectDir}/../../tests/data/stub/samples.tsv"
    samplesheet = "${projectDir}/../../tests/data/stub/samplesheet.csv"
    chromosomes = 'chr21,chr22'
}

outputDir = 'work/stub/results'
