// Defaults for every profile: small tasks, and the software of the cluster-only steps.
// Each process sets its own cpus, memory and time in workflow/nextflow/modules/; these apply otherwise.

process {
    cpus = 1
    memory = '4 GB'
    time = '2h'

    // Tools of the cluster-only steps come from two more pixi environments (pixi.toml), found through
    // PIXI_PROJECT_ROOT, which `pixi run` sets: 'bio' (STAR, salmon, samtools, bcftools, bedtools, sra-tools,
    // liftOver, gffread) is appended to PATH, so Python and R still come from the launching environment;
    // 'qtl' (Python with tensorQTL, PyTorch, pgenlib; plink2) comes first. tensorQTL and qtl are vendored wheels.
    withLabel: 'bio' {
        beforeScript = 'export PATH="$PATH:$PIXI_PROJECT_ROOT/.pixi/envs/bio/bin"'
    }
    withLabel: 'qtl' {
        beforeScript = 'export PATH="$PIXI_PROJECT_ROOT/.pixi/envs/qtl/bin:$PATH:$PIXI_PROJECT_ROOT/.pixi/envs/bio/bin" PYTHONPATH="$PIXI_PROJECT_ROOT/envs/vendor/tensorqtl-1.0.10:$PIXI_PROJECT_ROOT/envs/vendor/qtl-0.1.10"'
    }
}
